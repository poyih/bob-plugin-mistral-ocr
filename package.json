{
  "name": "bob-plugin-mistral-ocr-tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:syntax": "node scripts/build-source.mjs --check && node scripts/check-syntax.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:metadata": "node scripts/validate-release-metadata.mjs",
    "check:metadata:deep": "node scripts/validate-release-metadata.mjs --check-assets --check-tags",
    "test": "node --test",
    "test:live": "node scripts/smoke-ocr.mjs",
    "test:bob": "osascript -l JavaScript scripts/smoke-bob.js tests/fixtures/ocr-sample.png",
    "test:jsc": "swift -module-cache-path /private/tmp/mistral-ocr-swift-cache scripts/check-jsc.swift",
    "build:source": "node scripts/build-source.mjs",
    "build": "node scripts/build-source.mjs && node scripts/build-plugin.mjs",
    "stage:release": "node scripts/stage-release.mjs",
    "check:archive": "node scripts/build-plugin.mjs --check dist/Mistral-OCR.bobplugin",
    "ci": "node scripts/ci.mjs"
  }
}
